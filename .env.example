# Copy to .env.local for local `vercel dev`. NEVER commit real values.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key file. Keep the \n sequences as-is (quoted on one line) — they are handled in code.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the-long-id-from-the-sheet-url
